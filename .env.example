# Copy to .env and fill in. CLI flags override these; real environment variables override .env.
# Every value is optional: anything missing is asked for in the terminal.

# Meeting link (links expire - update this each time). Pasting a whole invite text also works.
MEETING_URL=

# WHEN to join - pick ONE:
#   JOIN_AT     exact:   "14:30" | "14:30:15" | "2:30pm" | "2026-10-09 14:30" | "+10m" | "now"
#   JOIN_WINDOW random:  "09:55-10:05"  (a random moment inside the window; overnight windows work)
JOIN_AT=
JOIN_WINDOW=07:58-08:08
TIMEZONE=

# --- Browser / account -------------------------------------------------------
# Which of YOUR existing browser profiles to use (name, folder like "Profile 1", or a number).
# Empty = you are asked once (in the terminal) and the answer is remembered. "ask" = ask every time.
# The profile is COPIED into the project folder (see PROFILE_STORE); your real profile is never modified.
BROWSER_PROFILE=
# Where the copy is kept. Default: <project>/browser-profiles  (contains your login cookies - never share or commit it)
# PROFILE_STORE=
# Advanced: use this exact user-data folder as-is (disables profile picking/copying)
# PROFILE_DIR=
# auto = your SYSTEM DEFAULT browser (falls back to Chrome, Brave, Edge, Firefox if it is unsupported).
# Or force one: chrome | msedge | brave | firefox | chromium
BROWSER=auto
# true = refuse to join as an anonymous guest if the profile is not signed in
REQUIRE_LOGIN=true
# Open Teams before waiting to verify the browser + sign-in work (recommended)
PREFLIGHT=true
# Only used when REQUIRE_LOGIN=false
DISPLAY_NAME=Guest

# --- Behaviour ---------------------------------------------------------------
SCREENSHOT_DIR=screenshots
LOBBY_TIMEOUT_MINUTES=30
# How long to stay in the meeting after you are admitted. 120 = 2 hours. 0 = until the meeting ends (or Ctrl+C)
STAY_MINUTES=0
# Screenshot every N minutes while in the meeting (plus one at join and one right before leaving). 0 = only at join
SCREENSHOT_INTERVAL_MINUTES=20
LEAVE_AFTER_SCREENSHOT=false
MAX_ATTEMPTS=5
# If the join time already passed by less than this, join immediately instead of failing
GRACE_MINUTES=20
# If the time passed by MORE than the grace, schedule it for tomorrow instead of failing
ROLL_OVER=false
# Keep the browser sandbox ON (avoids the red "--no-sandbox" warning banner). Only set true on Linux containers / root
NO_SANDBOX=false
